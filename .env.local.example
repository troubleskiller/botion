# dev-spec 第 3 节。复制成 .env.local 再填。
# .env.local 已在 .gitignore 里 —— 不要提交真实值。

# ── Phase 1 需要这三个 ──────────────────────────────────────────────────
# Supabase 项目 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅服务端，绝不暴露给客户端。Phase 1 只有 scripts/verify-rls.mjs 用它
# 来建两个测试账号做越权自测；App 的代码路径里不读这个变量。
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 2 及以后，现在留空 ────────────────────────────────────────────
# 仅服务端。Phase 3 的食物照片热量估算
ANTHROPIC_API_KEY=

# Phase 2 的 Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Phase 2 的 Vercel Cron 端点保护
CRON_SECRET=
